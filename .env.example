# Flask
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-this-to-a-random-secret-key

# Database
DATABASE_URL=postgresql://onboarding_user:onboarding_pass@localhost:5432/onboarding_db

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=onboarding-system

# AWS Credentials (Get these from IAM - see implementation_plan.md)
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_DEFAULT_REGION=us-east-1

# S3
S3_BUCKET_NAME=client-onboarding-docs
S3_ENCRYPTION=AES256

# AWS SES (for email notifications)
SES_SENDER_EMAIL=noreply@yourdomain.com

# App Settings
ITEMS_PER_PAGE=20
INVOICE_TAX_RATE=0.10
DOCUMENT_RETENTION_DAYS=365
